<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- 半透明遮罩：点这里直接关闭（不保存） -->
    <View
        android:id="@+id/quick_add_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <!-- 居中卡片：真正的输入区 -->
    <LinearLayout
        android:id="@+id/quick_add_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="28dp"
        android:orientation="vertical"
        android:background="@drawable/quick_add_card_bg"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quick_add_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text" />

        <EditText
            android:id="@+id/quick_add_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/add_todo_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:background="@null"
            android:textSize="16sp"
            android:textColor="@color/widget_text"
            android:textColorHint="@color/widget_subtext" />

        <!-- 分类选择 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/quick_cat_none"
                style="@style/QuickCatChip"
                android:text="@string/cat_none" />
            <TextView
                android:id="@+id/quick_cat_work"
                style="@style/QuickCatChip"
                android:text="@string/cat_work" />
            <TextView
                android:id="@+id/quick_cat_study"
                style="@style/QuickCatChip"
                android:text="@string/cat_study" />
            <TextView
                android:id="@+id/quick_cat_life"
                style="@style/QuickCatChip"
                android:text="@string/cat_life" />
        </LinearLayout>

        <!-- 到期按钮 -->
        <Button
            android:id="@+id/quick_due_btn"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/due_none" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/quick_add_cancel"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel" />

            <Button
                android:id="@+id/quick_add_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
